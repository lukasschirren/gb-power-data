# ---- data: nothing under data/ is tracked unless re-included here --------------------------------
# `dir/*` not `dir/`: a trailing slash would stop git descending, and the re-includes below
# would silently do nothing.
data/*
!data/raw/
data/raw/*
# provenance notes for hand-downloaded sources
!data/raw/manual/
data/raw/manual/*
!data/raw/manual/README.md
# OSUKED Power Station Dictionary snapshot (MIT licence, 277 rows)
!data/raw/psd/
!data/reference/
data/reference/*
!data/reference/README.md
# hand-curated tables and overrides: the pipeline cannot be reproduced without them
!data/reference/plant_overrides.yaml
!data/reference/cfd_overrides.yaml
!data/reference/tech_parameters.yaml
!data/reference/bmu_crosswalk_overrides.yaml
!data/reference/wind_farm_map_overrides.csv
!data/reference/gsp_overrides.csv
!data/reference/cfd_round_params.csv
!data/reference/gsp_group_demand_weights.csv
!data/reference/ninja_sites.csv
!data/reference/benchmarks_*.csv
!data/reference/company_groups.csv
!data/reference/company_owners.csv
!data/reference/ownership_sources.csv
!data/reference/bmu_lead_parties.csv
!data/reference/bmu_left_register.csv
!data/reference/companies_house_numbers.csv
!data/reference/crown_estate_farms.csv
# never re-include crown_estate_ownership_reports.csv (a transcription of The Crown Estate's report tables):
# its terms allow own use only and forbid passing digital copies to third parties
!data/reference/dukes_bmu_map.csv
!data/reference/thermal_parameters.csv
!data/reference/thermal_parameter_sources.csv
!data/reference/thermal_station_bmu.csv
!data/reference/thermal_unit_efficiency.csv
!data/reference/official_statistics.csv
!data/reference/investment_parameters.csv
!data/reference/investment_parameter_sources.csv
!data/reference/ic_rated_capacity.csv
!data/reference/rego_prices.csv
!data/reference/rego_price_sources.csv
!data/reference/rego_statistics.csv
# small derived tables whose inputs are large or slow to pull (generator named in data/reference/README.md)
!data/reference/pecd_onshore_zone_to_nuts2.csv
!data/reference/pecd_offshore_zone_to_nuts2.csv
!data/reference/nuts2_to_gsp_group_area_weights.csv
!data/reference/ninja_sites_by_zone.csv
!data/reference/tech_flexibility_empirical.csv
!data/reference/nuclear_availability_by_year.csv
!data/reference/bmu_crosswalk.csv
!data/reference/cfd_bmu_map.csv
!data/reference/wind_farm_map.csv
!data/reference/bm_dynamic_by_tech.csv

# ---- licensed market data: Nord Pool / N2EX and EPEX SPOT, and anything derived from it ----------
# Kept after every re-include above so none of them can let such a file through.
data/**/*nordpool*
data/**/*n2ex*
data/**/*N2EX*
data/**/*epex*
data/**/*EPEX*
# anything priced at or derived from the day-ahead auctions carries "dayahead" in its name
# (dayahead_price_*, storage_revenue_dayahead_*)
data/**/*dayahead*
data/**/curve_compare_*
data/**/demand_curves_*
data/**/mid_target_*

# ---- credentials ---------------------------------------------------------------------------------
*token*.txt
*credential*.txt
*.pem
*.key
.env

# ---- local configuration and tooling -------------------------------------------------------------
config.local.yaml
*.local.cmd
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.ipynb_checkpoints/
*.log
.vscode/
.idea/
.claude/
